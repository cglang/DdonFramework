<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ddon.Desktop.Avalonia\Ddon.Desktop.Avalonia.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings*.json" CopyToOutputDirectory="PreserveNewest"/>
    <Content Include="wwwroot\**" CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>

  <Target Name="NpmInstall" BeforeTargets="Build" Condition="!Exists('frontend\node_modules')">
    <Exec Command="npm install" WorkingDirectory="frontend"/>
  </Target>

  <Target Name="NpmBuild" BeforeTargets="Build" Condition="'$(Configuration)'=='Release'">
    <Exec Command="npm run build" WorkingDirectory="frontend"/>
  </Target>
  
</Project>
