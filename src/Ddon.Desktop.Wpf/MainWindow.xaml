<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="Ddon.Desktop.Wpf.MainWindow"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#fff" d:DesignHeight="338.267" d:DesignWidth="586.379">
    <Grid>
        <Grid x:Name="LoadingPanel" Background="#fff">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="LoadingTitleBlock" FontSize="28" Foreground="#409eff"
                           HorizontalAlignment="Center" Margin="0,0,0,20"
                           FontWeight="Light" />
                <ProgressBar Width="200" Height="4" IsIndeterminate="True"
                             Foreground="#409eff" Background="#ecf5ff"
                             Margin="0,0,0,10" />
                <TextBlock x:Name="LoadingTextBlock" FontSize="13" Foreground="#909399"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
        <wv2:WebView2 x:Name="WebView" Visibility="Collapsed" />
    </Grid>
</Window>